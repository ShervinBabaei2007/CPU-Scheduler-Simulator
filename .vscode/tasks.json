{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "GCC Build",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "& 'C:\\mingw64\\bin\\g++.exe' -g -std=c++20 (Get-ChildItem *.cpp | ForEach-Object {$_.Name}) -o main.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Clang Build",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "& 'C:\\Program Files\\LLVM\\bin\\clang++.exe' -g -std=c++20 (Get-ChildItem *.cpp | ForEach-Object {$_.Name}) -o main.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": "build"
    },
    {
      "label": "MSVC Build",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-Command",
        "cl /Zi /std:c++20 /EHsc (Get-ChildItem *.cpp | ForEach-Object {$_.Name}) /Fe:main.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$msCompile"
      ],
      "group": "build"
    },
    {
      "type": "cppbuild",
      "label": "C/C++: g++.exe build active file",
      "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
      "args": [
        "-fdiagnostics-color=always",
        "-g",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Task generated by Debugger."
    }
  ]
}